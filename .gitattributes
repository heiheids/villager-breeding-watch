# 统一换行策略：仓库内存 LF，Windows 工作区检出为 CRLF。
# 不这么做的话，Windows 上第一次 clone 会把每个文件都标成已修改（整文件 diff）。

* text=auto

# 源码与脚本：统一 LF
*.java      text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.ps1       text eol=crlf
*.bat       text eol=crlf
gradlew     text eol=lf

# 二进制：不要做任何转换
*.jar   binary
*.png   binary
*.ogg   binary
*.zip   binary
